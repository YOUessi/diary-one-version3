{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Planner + physically scoped Gallery V02, source-bound experimental Chapter result",
  "type": "object",
  "required": [
    "schema_version",
    "editor_policy",
    "experimental",
    "production_ready",
    "session_id",
    "bundle_manifest_sha256",
    "delivery_state",
    "coverage_status",
    "unresolved_asset_ids",
    "chapters",
    "ahas",
    "selected_memory_outcomes",
    "trace",
    "decision_trace",
    "day_summary",
    "chapter_count_rationale",
    "excluded_non_lived_frame_ids",
    "observations",
    "moments"
  ],
  "properties": {
    "schema_version": {
      "const": "DIARY_ONE_PLANNER_GALLERY_CHAPTER_V02"
    },
    "editor_policy": {
      "const": "PLANNER_GALLERY_SCOPED_EDITOR_V02"
    },
    "experimental": {
      "const": true
    },
    "production_ready": {
      "const": false
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "bundle_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "delivery_state": {
      "const": "READY_PRIMARY_COPY"
    },
    "coverage_status": {
      "const": "INPUT_ALL_FRAMES_SUBMITTED"
    },
    "unresolved_asset_ids": {
      "type": "array",
      "maxItems": 0
    },
    "day_summary": {
      "type": "string",
      "minLength": 1
    },
    "chapter_count_rationale": {
      "type": "string",
      "minLength": 1
    },
    "excluded_non_lived_frame_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 0
    },
    "moments": {
      "type": "array",
      "maxItems": 0
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "story",
          "preview_story",
          "hero_asset_id",
          "hero_frame_id",
          "selected_media",
          "experience_frame_ids",
          "key_moments",
          "tags",
          "highlights",
          "claims",
          "moment_ids",
          "publication_status",
          "source_clip_start",
          "source_clip_end"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "story": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1800
          },
          "preview_story": {
            "type": "string",
            "minLength": 1
          },
          "hero_asset_id": {
            "type": "string",
            "minLength": 1
          },
          "hero_frame_id": {
            "type": "string",
            "minLength": 1
          },
          "selected_media": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "asset_id",
                "source_asset_id",
                "media_kind",
                "role",
                "representative_frame_id",
                "evidence_frame_ids",
                "start_ms",
                "end_ms",
                "focus_pts_ms",
                "range_basis"
              ],
              "properties": {
                "asset_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_asset_id": {
                  "type": "string",
                  "minLength": 1
                },
                "media_kind": {
                  "enum": [
                    "PHOTO",
                    "VIDEO"
                  ]
                },
                "role": {
                  "enum": [
                    "HERO",
                    "SUPPORT"
                  ]
                },
                "representative_frame_id": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_frame_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "maxItems": 2
                },
                "start_ms": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "end_ms": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "focus_pts_ms": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "range_basis": {
                  "enum": [
                    "STILL_IMAGE",
                    "WHOLE_SOURCE_CLIP",
                    "EVIDENCE_ONLY_NO_VIDEO_RANGE"
                  ]
                }
              }
            }
          },
          "experience_frame_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 250
          },
          "key_moments": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "required": [
                "description",
                "frame_ids"
              ],
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "frame_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "maxItems": 12
                }
              }
            }
          },
          "tags": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "highlights": {
            "type": "array",
            "maxItems": 0
          },
          "claims": {
            "type": "array",
            "maxItems": 0
          },
          "moment_ids": {
            "type": "array",
            "maxItems": 0
          },
          "publication_status": {
            "const": "STAGED_PREVIEW_VALIDATED"
          },
          "source_clip_start": {
            "type": "integer",
            "minimum": 1
          },
          "source_clip_end": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "ahas": {
      "type": "array",
      "maxItems": 0
    },
    "selected_memory_outcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "items": {
        "type": "object",
        "required": [
          "memory_id",
          "memory_type",
          "visibility_state"
        ],
        "properties": {
          "memory_id": {
            "type": "string",
            "minLength": 1
          },
          "memory_type": {
            "const": "CHAPTER"
          },
          "visibility_state": {
            "const": "VISIBLE_PREVIEW"
          }
        }
      }
    },
    "trace": {
      "type": "object",
      "required": [
        "pipeline_version",
        "model",
        "provider",
        "request_ids",
        "model_calls",
        "input_tokens",
        "output_tokens",
        "estimated_cost_usd",
        "stage_metrics"
      ],
      "properties": {
        "pipeline_version": {
          "const": "X02_PLANNER_GALLERY_CHAPTER_V02"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "request_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 30
        },
        "model_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "stage_metrics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30
        }
      }
    },
    "decision_trace": {
      "type": "object",
      "required": [
        "no_staged_pipeline",
        "visual_fact_reviewed",
        "semantic_copy_verified",
        "input_coverage",
        "prompt_sha256",
        "clip_ownership",
        "chapter_clip_intervals",
        "planner_prompt_sha256",
        "gallery_prompt_sha256"
      ],
      "properties": {
        "no_staged_pipeline": {
          "const": false
        },
        "visual_fact_reviewed": {
          "const": false
        },
        "semantic_copy_verified": {
          "const": false
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_coverage": {
          "type": "object",
          "required": [
            "frames_submitted",
            "clips_received",
            "image_bytes"
          ],
          "properties": {
            "frames_submitted": {
              "type": "integer",
              "minimum": 1,
              "maximum": 250
            },
            "clips_received": {
              "type": "integer",
              "minimum": 1
            },
            "image_bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "clip_ownership": {
          "const": "EXPLICIT_CONTIGUOUS_ONE_CHAPTER_PER_CLIP"
        },
        "planner_prompt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "gallery_prompt_sha256": {
          "type": "array",
          "minItems": 1,
          "maxItems": 14,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "chapter_clip_intervals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 14,
          "items": {
            "type": "object",
            "required": [
              "candidate_id",
              "start_clip",
              "end_clip"
            ],
            "additionalProperties": false,
            "properties": {
              "candidate_id": {
                "type": "string",
                "pattern": "^C[0-9]{2}$"
              },
              "start_clip": {
                "type": "integer",
                "minimum": 1
              },
              "end_clip": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "gallery_model_input_frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 14,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 250
          }
        }
      }
    }
  }
}
