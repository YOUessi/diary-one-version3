{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexleap.example/contracts/diary-one-production-pipeline-v1.schema.json",
  "title": "Diary One Production-shaped Pipeline V1 Reference Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run",
    "writer_provenance",
    "upstream_stages",
    "s09",
    "memories",
    "hq_requests"
  ],
  "properties": {
    "contract_version": {"const": "DIARY_ONE_PRODUCTION_PIPELINE_V1_0"},
    "run": {"$ref": "#/$defs/run"},
    "writer_provenance": {"$ref": "#/$defs/writerProvenance"},
    "upstream_stages": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {"$ref": "#/$defs/upstreamStage"}
    },
    "s09": {"$ref": "#/$defs/s09"},
    "memories": {
      "type": "array",
      "maxItems": 8,
      "items": {"$ref": "#/$defs/memory"}
    },
    "hq_requests": {
      "type": "array",
      "maxItems": 28,
      "items": {"$ref": "#/$defs/hqRequest"}
    },
    "cross_memory_reuse_decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/reuseDecision"},
      "default": []
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "stringArray": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "user_local_day", "revision_id", "revision_kind", "snapshot_id", "pipeline_version"],
      "properties": {
        "run_id": {"$ref": "#/$defs/nonEmptyString"},
        "user_local_day": {"type": "string", "format": "date"},
        "revision_id": {"$ref": "#/$defs/nonEmptyString"},
        "revision_kind": {"enum": ["PREVIEW", "FINAL"]},
        "snapshot_id": {"$ref": "#/$defs/nonEmptyString"},
        "pipeline_version": {"$ref": "#/$defs/nonEmptyString"},
        "expected_published_head": {"type": ["string", "null"]}
      }
    },
    "writerProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_mode",
        "source_artifact_ref",
        "provider",
        "model",
        "prompt_version",
        "parameter_version",
        "logical_calls",
        "input_tokens",
        "output_tokens",
        "estimated_cost_usd",
        "cache_status"
      ],
      "properties": {
        "execution_mode": {"const": "REFERENCE_PRECOMPUTED"},
        "source_artifact_ref": {"$ref": "#/$defs/nonEmptyString"},
        "provider": {"$ref": "#/$defs/nonEmptyString"},
        "model": {"$ref": "#/$defs/nonEmptyString"},
        "prompt_version": {"$ref": "#/$defs/nonEmptyString"},
        "parameter_version": {"$ref": "#/$defs/nonEmptyString"},
        "logical_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "estimated_cost_usd": {"type": "number", "minimum": 0},
        "cache_status": {"enum": ["NOT_APPLICABLE_REFERENCE", "REFERENCE_CACHE_HIT"]}
      }
    },
    "upstreamStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "artifact_ref", "revision_id", "snapshot_id", "status", "fingerprint"],
      "properties": {
        "stage_id": {"pattern": "^S(0[0-9]|10)$"},
        "artifact_ref": {"$ref": "#/$defs/nonEmptyString"},
        "revision_id": {"$ref": "#/$defs/nonEmptyString"},
        "snapshot_id": {"$ref": "#/$defs/nonEmptyString"},
        "status": {"const": "READY"},
        "fingerprint": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "s09": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day_state", "selected_chapter_ids", "selected_aha_ids", "chapter_aha_pair_decisions"],
      "properties": {
        "day_state": {"enum": ["CHAPTER_DAY", "HIGHLIGHT_DAY", "EMPTY_DAY"]},
        "selected_chapter_ids": {"$ref": "#/$defs/stringArray"},
        "selected_aha_ids": {"$ref": "#/$defs/stringArray"},
        "fifth_chapter_gate": {"const": "PASS"},
        "chapter_aha_pair_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chapter_id", "aha_id", "decision"],
            "properties": {
              "chapter_id": {"$ref": "#/$defs/nonEmptyString"},
              "aha_id": {"$ref": "#/$defs/nonEmptyString"},
              "decision": {"enum": ["DISJOINT_PASS", "NARRATIVELY_DISTINCT_PASS"]}
            }
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "required": [
        "memory_id",
        "memory_type",
        "candidate_id",
        "revision_id",
        "capture_start_ms",
        "selected_content_unit_ids",
        "active_media",
        "claims",
        "narrative",
        "canonical_assignments",
        "entity_links"
      ],
      "properties": {
        "memory_id": {"$ref": "#/$defs/nonEmptyString"},
        "memory_type": {"enum": ["CHAPTER", "AHA"]},
        "candidate_id": {"$ref": "#/$defs/nonEmptyString"},
        "revision_id": {"$ref": "#/$defs/nonEmptyString"},
        "capture_start_ms": {"type": "integer", "minimum": 0},
        "selected_content_unit_ids": {"$ref": "#/$defs/stringArray"},
        "compact_pair_gate": {"enum": ["PASS", "NOT_APPLICABLE"]},
        "active_media": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/media"}},
        "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
        "narrative": {"$ref": "#/$defs/narrative"},
        "canonical_assignments": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/assignment"}},
        "entity_links": {"type": "array", "items": {"$ref": "#/$defs/entityLink"}},
        "protected_user_text": {"type": "array", "items": {"type": "object"}},
        "d1_survivor_plans": {
          "type": "array",
          "items": {"$ref": "#/$defs/d1SurvivorPlan"}
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_id", "media_plan_ref", "evidence_anchor_ref", "raw_asset_id", "format", "hq_request_id", "semantic_scope_id", "source_family_id", "is_hero"],
      "properties": {
        "media_id": {"$ref": "#/$defs/nonEmptyString"},
        "media_plan_ref": {"$ref": "#/$defs/nonEmptyString"},
        "evidence_anchor_ref": {"$ref": "#/$defs/nonEmptyString"},
        "raw_asset_id": {"$ref": "#/$defs/nonEmptyString"},
        "format": {"enum": ["PHOTO", "LIVE_2S", "VIDEO_5S"]},
        "hq_request_id": {"$ref": "#/$defs/nonEmptyString"},
        "semantic_scope_id": {"$ref": "#/$defs/nonEmptyString"},
        "source_family_id": {"$ref": "#/$defs/nonEmptyString"},
        "is_hero": {"type": "boolean"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "normalized_assertion", "semantic_status", "support_grade", "evidence_refs", "allowed_surfaces"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/nonEmptyString"},
        "normalized_assertion": {"$ref": "#/$defs/nonEmptyString"},
        "semantic_status": {"const": "CLAIM_SEMANTIC_SUPPORTED"},
        "support_grade": {"enum": ["STRONG", "MODERATE"]},
        "evidence_refs": {"$ref": "#/$defs/stringArray"},
        "allowed_surfaces": {"$ref": "#/$defs/stringArray"},
        "required_media_ids": {"$ref": "#/$defs/stringArray"}
      }
    },
    "narrative": {
      "type": "object",
      "required": ["locale", "surface_claim_refs", "span_bindings"],
      "properties": {
        "locale": {"const": "zh-Hans"},
        "title": {"type": ["string", "null"]},
        "title_outcome": {"enum": ["PRESENT", "OMITTED_POLICY_DEFERRED_D2E"]},
        "title_length_class": {"enum": ["BASE_2_10", "SOFT_EXTENSION_11_12"]},
        "title_soft_extension_reason": {"type": "string"},
        "time_label": {"type": ["string", "null"]},
        "story": {"type": ["string", "null"]},
        "moment_line": {"type": ["string", "null"]},
        "light_affect_permission_ref": {"type": "string"},
        "light_affect_target_claim_ref": {"type": "string"},
        "surface_claim_refs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/stringArray"}},
        "span_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/spanBinding"}
        }
      }
    },
    "spanBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "kind", "start", "end", "text"],
      "properties": {
        "surface": {"enum": ["TITLE", "STORY", "AHA_MOMENT_LINE"]},
        "kind": {"enum": ["CLAIM", "TONE_PERMISSION"]},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "text": {"$ref": "#/$defs/nonEmptyString"},
        "claim_refs": {"$ref": "#/$defs/stringArray"},
        "permission_ref": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_id", "role", "rank", "claim_refs", "evidence_refs"],
      "properties": {
        "concept_id": {"$ref": "#/$defs/nonEmptyString"},
        "role": {"enum": ["PRIMARY", "SECONDARY"]},
        "rank": {"type": "integer", "minimum": 0},
        "claim_refs": {"$ref": "#/$defs/stringArray"},
        "evidence_refs": {"$ref": "#/$defs/stringArray"}
      }
    },
    "entityLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "entity_type", "display_name", "claim_refs", "evidence_refs"],
      "properties": {
        "entity_id": {"$ref": "#/$defs/nonEmptyString"},
        "entity_type": {"enum": ["PLACE", "PERSON", "PET", "VENUE", "OTHER_NAMED_ENTITY"]},
        "display_name": {"$ref": "#/$defs/nonEmptyString"},
        "claim_refs": {"$ref": "#/$defs/stringArray"},
        "evidence_refs": {"$ref": "#/$defs/stringArray"}
      }
    },
    "hqRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "raw_asset_id", "source_start_ms", "source_end_ms", "routes"],
      "properties": {
        "request_id": {"$ref": "#/$defs/nonEmptyString"},
        "raw_asset_id": {"$ref": "#/$defs/nonEmptyString"},
        "source_start_ms": {"type": "integer", "minimum": 0},
        "source_end_ms": {"type": "integer", "minimum": 0},
        "routes": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/route"}}
      }
    },
    "route": {
      "type": "object",
      "required": ["route_id", "priority", "format", "source_ref", "evidence_anchor_ref", "semantic_scope_id", "reference_outcome"],
      "properties": {
        "route_id": {"$ref": "#/$defs/nonEmptyString"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 2},
        "format": {"enum": ["PHOTO", "LIVE_2S", "VIDEO_5S"]},
        "source_ref": {"$ref": "#/$defs/nonEmptyString"},
        "evidence_anchor_ref": {"$ref": "#/$defs/nonEmptyString"},
        "semantic_scope_id": {"$ref": "#/$defs/nonEmptyString"},
        "source_family_id": {"$ref": "#/$defs/nonEmptyString"},
        "reference_outcome": {"enum": ["SUCCESS", "TRANSIENT_FAILURE", "TERMINAL_FAILURE", "CONTRACT_INVALID"]}
      }
    },
    "d1SurvivorPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failed_media_id", "survivor_media_ids", "decision"],
      "properties": {
        "failed_media_id": {"$ref": "#/$defs/nonEmptyString"},
        "survivor_media_ids": {"$ref": "#/$defs/stringArray"},
        "decision": {"const": "PASS"},
        "resulting_compact_pair_gate": {"enum": ["PASS", "NOT_APPLICABLE"]},
        "alternate_hero_media_id": {"type": ["string", "null"]}
      }
    },
    "reuseDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_family_id", "memory_ids", "decision"],
      "properties": {
        "source_family_id": {"$ref": "#/$defs/nonEmptyString"},
        "memory_ids": {"$ref": "#/$defs/stringArray"},
        "decision": {"const": "NECESSARY_EXACT_REUSE"}
      }
    }
  }
}
