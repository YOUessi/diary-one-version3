{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexleap.example/contracts/diary-one-production-pipeline-v1.outputs.schema.json",
  "title": "Diary One Production-shaped Pipeline V1 Reference Artifacts",
  "description": "Union schema for the immutable JSON artifacts emitted by the local S00-S13 reference.",
  "oneOf": [
    {"$ref": "#/$defs/s11Bundle"},
    {"$ref": "#/$defs/s12Decision"},
    {"$ref": "#/$defs/s13Bundle"},
    {"$ref": "#/$defs/userExport"},
    {"$ref": "#/$defs/auditRun"},
    {"$ref": "#/$defs/runManifest"}
  ],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "fingerprint": {"type": "string", "minLength": 32},
    "s11Bundle": {
      "type": "object",
      "required": ["contract_version", "revision_id", "snapshot_id", "registry_version", "locale_profile", "writer_provenance", "validation_provenance", "memories", "status", "fingerprint"],
      "properties": {
        "contract_version": {"const": "DIARY_ONE_S11_GROUNDED_NARRATIVE_V1_0"},
        "revision_id": {"$ref": "#/$defs/nonEmptyString"},
        "snapshot_id": {"$ref": "#/$defs/nonEmptyString"},
        "registry_version": {"$ref": "#/$defs/nonEmptyString"},
        "locale_profile": {"const": "zh-Hans-CN-V1-TEST"},
        "writer_provenance": {"type": "object"},
        "validation_provenance": {"type": "object"},
        "memories": {"type": "array", "items": {"$ref": "#/$defs/s11Memory"}},
        "status": {"const": "S11_READY_FOR_S12"},
        "explicit_deferrals": {"type": "array", "items": {"type": "string"}},
        "fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "s11Memory": {
      "type": "object",
      "required": ["memory_id", "memory_type", "candidate_id", "capture_start_ms", "claim_ledger", "grounded_narrative", "canonical_tag_decisions", "entity_index_links", "display_label_candidates", "active_media", "status", "fingerprint"],
      "properties": {
        "memory_id": {"$ref": "#/$defs/nonEmptyString"},
        "memory_type": {"enum": ["CHAPTER", "AHA"]},
        "candidate_id": {"$ref": "#/$defs/nonEmptyString"},
        "capture_start_ms": {"type": "integer", "minimum": 0},
        "claim_ledger": {"type": "array", "minItems": 1},
        "grounded_narrative": {"type": "object"},
        "canonical_tag_decisions": {"type": "array", "maxItems": 4},
        "entity_index_links": {"type": "array"},
        "display_label_candidates": {"type": "array", "maxItems": 2},
        "protected_user_text": {"type": "array"},
        "active_media": {"type": "array", "minItems": 1, "maxItems": 5},
        "status": {"const": "MEMORY_NARRATIVE_READY"},
        "fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "s12Decision": {
      "type": "object",
      "required": ["contract_version", "phase", "revision_id", "snapshot_id", "decision", "status", "fingerprint"],
      "properties": {
        "contract_version": {"const": "DIARY_ONE_S12_TWO_PHASE_VALIDATION_V1_0"},
        "phase": {"enum": ["PRE_MATERIALIZATION", "ACTIVATION_AND_EXPORT"]},
        "revision_id": {"$ref": "#/$defs/nonEmptyString"},
        "snapshot_id": {"$ref": "#/$defs/nonEmptyString"},
        "decision": {
          "enum": [
            "MATERIALIZATION_ALLOWED",
            "NO_MATERIALIZATION_EMPTY_EXPORT_ALLOWED",
            "REFERENCE_EXPORT_ALLOWED",
            "OWNER_REPLAN_REQUIRED",
            "HOLD_RETRYABLE",
            "BLOCKED_NO_SAFE_CURRENT_REVISION",
            "VALIDATION_CONTRACT_INVALID"
          ]
        },
        "status": {"enum": ["PASS", "HOLD"]},
        "production_cas_executed": {"type": "boolean"},
        "fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "s13Bundle": {
      "type": "object",
      "required": ["contract_version", "phase", "revision_id", "snapshot_id", "reference_only", "active_request_count", "successful_reference_receipt_count", "receipts", "activation_deltas", "failures", "status", "fingerprint"],
      "properties": {
        "contract_version": {"const": "DIARY_ONE_S13_MATERIALIZATION_EXPORT_V1_0"},
        "phase": {"const": "REFERENCE_MATERIALIZATION"},
        "revision_id": {"$ref": "#/$defs/nonEmptyString"},
        "snapshot_id": {"$ref": "#/$defs/nonEmptyString"},
        "reference_only": {"const": true},
        "active_request_count": {"type": "integer", "minimum": 0},
        "successful_reference_receipt_count": {"type": "integer", "minimum": 0},
        "receipts": {"type": "array", "items": {"$ref": "#/$defs/referenceReceipt"}},
        "activation_deltas": {"type": "array", "items": {"type": "object"}},
        "omitted_media_ids": {"type": "array", "items": {"type": "string"}},
        "resolved_failures": {"type": "array", "items": {"type": "object"}},
        "failures": {"type": "array", "items": {"type": "object"}},
        "status": {"enum": ["REFERENCE_MATERIALIZATION_COMPLETE", "HOLD"]},
        "fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "referenceReceipt": {
      "type": "object",
      "required": ["request_id", "route_id", "memory_id", "media_id", "format", "source_ref", "source_interval_ms", "evidence_anchor_ref", "semantic_scope_id", "source_family_id", "receipt_checksum", "materialization_status", "media_bytes_materialized"],
      "properties": {
        "request_id": {"$ref": "#/$defs/nonEmptyString"},
        "route_id": {"$ref": "#/$defs/nonEmptyString"},
        "memory_id": {"$ref": "#/$defs/nonEmptyString"},
        "media_id": {"$ref": "#/$defs/nonEmptyString"},
        "format": {"enum": ["PHOTO", "LIVE_2S", "VIDEO_5S"]},
        "source_ref": {"$ref": "#/$defs/nonEmptyString"},
        "source_interval_ms": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}},
        "evidence_anchor_ref": {"$ref": "#/$defs/nonEmptyString"},
        "semantic_scope_id": {"$ref": "#/$defs/nonEmptyString"},
        "source_family_id": {"$ref": "#/$defs/nonEmptyString"},
        "receipt_checksum": {"$ref": "#/$defs/fingerprint"},
        "materialization_status": {"const": "REFERENCE_RECEIPT_SUCCESS"},
        "media_bytes_materialized": {"const": false}
      }
    },
    "userExport": {
      "type": "object",
      "required": ["export_contract_version", "reference_only", "user_local_day", "revision_id", "day_state", "chapters", "ahas", "activation_validation_ref", "fingerprint"],
      "properties": {
        "export_contract_version": {"const": "DIARY_ONE_USER_DIARY_EXPORT_V1_0"},
        "reference_only": {"const": true},
        "user_local_day": {"type": "string", "format": "date"},
        "revision_id": {"$ref": "#/$defs/nonEmptyString"},
        "day_state": {"enum": ["CHAPTER_DAY", "HIGHLIGHT_DAY", "EMPTY_DAY"]},
        "chapters": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/exportMemory"}},
        "ahas": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/exportMemory"}},
        "activation_validation_ref": {"$ref": "#/$defs/fingerprint"},
        "fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "exportMemory": {
      "type": "object",
      "required": ["memory_id", "memory_type", "narrative", "display_labels", "visible_media", "protected_user_text"],
      "properties": {
        "memory_id": {"$ref": "#/$defs/nonEmptyString"},
        "memory_type": {"enum": ["CHAPTER", "AHA"]},
        "narrative": {"$ref": "#/$defs/userVisibleNarrative"},
        "display_labels": {"type": "array", "maxItems": 2},
        "visible_media": {"type": "array", "minItems": 1, "maxItems": 5},
        "protected_user_text": {"type": "array"}
      }
    },
    "userVisibleNarrative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_label"],
      "properties": {
        "title": {"type": ["string", "null"]},
        "story": {"type": ["string", "null"]},
        "moment_line": {"type": ["string", "null"]},
        "time_label": {"type": ["string", "null"]}
      }
    },
    "auditRun": {
      "type": "object",
      "required": ["audit_contract_version", "input_fingerprint", "upstream_trace", "s11_fingerprint", "s12_pre_fingerprint", "s13_fingerprint", "s12_activation_fingerprint", "export_fingerprint", "cost_provenance", "status"],
      "properties": {
        "audit_contract_version": {"const": "DIARY_ONE_INTERNAL_AUDIT_RUN_V1_0"},
        "input_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "upstream_trace": {"type": "array", "minItems": 11},
        "cost_provenance": {"type": "object"},
        "status": {"const": "REFERENCE_AUDIT_COMPLETE"}
      }
    },
    "runManifest": {
      "type": "object",
      "required": ["contract_version", "input_fingerprint", "full_flow_status", "stages", "reference_only", "explicit_non_claims"],
      "properties": {
        "contract_version": {"const": "DIARY_ONE_PRODUCTION_PIPELINE_V1_0"},
        "input_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "full_flow_status": {"enum": ["REFERENCE_VALIDATED_NOT_CLOUD_PRODUCTION", "HOLD_NO_REFERENCE_EXPORT"]},
        "stages": {"type": "array", "minItems": 14},
        "reference_only": {"const": true},
        "explicit_non_claims": {"type": "array", "minItems": 5, "items": {"type": "string"}}
      }
    }
  }
}
