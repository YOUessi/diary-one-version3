{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diary.one/contracts/experiment_bundle_v01.schema.json",
  "title": "Diary One Experiment Bundle V01",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_version", "research_only", "session", "device", "media_profile", "source", "processing"],
  "properties": {
    "bundle_version": {"const": "DIARY_ONE_EXPERIMENT_BUNDLE_V01"},
    "research_only": {"const": true},
    "session": {
      "type": "object",
      "required": ["session_id", "exported_at", "timezone"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "exported_at": {"type": "string", "format": "date-time"},
        "timezone": {"type": "string", "minLength": 1}
      }
    },
    "device": {
      "type": "object",
      "required": ["device_id", "hardware_revision", "firmware_version", "sdk_version"],
      "properties": {
        "device_id": {"type": "string"},
        "hardware_revision": {"type": "string"},
        "firmware_version": {"type": "string"},
        "sdk_version": {"type": "string"}
      }
    },
    "media_profile": {
      "type": "object",
      "required": ["profile_id", "width", "height", "orientation", "aspect_ratio"],
      "properties": {
        "profile_id": {"type": "string"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "orientation": {"const": "PORTRAIT"},
        "aspect_ratio": {"const": "3:4"}
      }
    },
    "source": {
      "type": "object",
      "required": ["kind", "relative_path", "sha256", "duration_ms"],
      "properties": {
        "kind": {"enum": ["CONTINUOUS_VIDEO", "FIXTURE"]},
        "relative_path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "duration_ms": {"type": "integer", "minimum": 9000}
      }
    },
    "processing": {
      "type": "object",
      "required": ["capture_interval_ms", "logical_asset_duration_ms", "frame_offsets_ms", "materialize_logical_assets"],
      "properties": {
        "capture_interval_ms": {"const": 120000},
        "logical_asset_duration_ms": {"const": 9000},
        "frame_offsets_ms": {"const": [1500, 4500, 7500]},
        "materialize_logical_assets": {"const": false}
      }
    }
  }
}

