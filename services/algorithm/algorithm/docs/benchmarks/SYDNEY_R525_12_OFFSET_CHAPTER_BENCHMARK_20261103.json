    "chapters_details": [
      {
        "index": 1,
        "title": "海滨步道与钟楼建筑",
        "hero": "sydney_00_000205-f0",
        "main_gallery_count": 3,
        "highlight_count": 0,
        "episode_ids_in_main_gallery": [
          "E01",
          "E02",
          "E03"
        ],
        "story": "海滨步道上有行人走动或休息，右侧停靠一艘大型白色游轮，背景可见拱形大桥。露天咖啡座区域旁有一座米色钟楼建筑。"
      },
      {
        "index": 2,
        "title": "砖石街道与步行桥",
        "hero": "sydney_00_000289-f0",
        "main_gallery_count": 4,
        "highlight_count": 1,
        "episode_ids_in_main_gallery": [
          "E03",
          "E04",
          "E05"
        ],
        "story": "铺有砖石的街道上有多名行人行走，左侧可见带有“BOND”字样的招牌。一座宽阔的步行桥两侧排列着彩旗和路灯，多名行人在桥上漫步，背景可见白色帐篷状建筑及城市高楼。"
      },
      {
        "index": 3,
        "title": "商业拱廊与红砖建筑",
        "hero": "sydney_00_001141-f1",
        "main_gallery_count": 4,
        "highlight_count": 0,
        "episode_ids_in_main_gallery": [
          "E05",
          "E06"
        ],
        "story": "Queen Victoria Building底层的商铺设有遮阳棚与入口。一群行人穿过带有汉字和石狮雕像的红金拱门。"
      },
      {
        "index": 4,
        "title": "城市步行区与室内拱廊",
        "hero": "sydney_00_001273-f0",
        "main_gallery_count": 4,
        "highlight_count": 0,
        "episode_ids_in_main_gallery": [
          "E06",
          "E07"
        ],
        "story": "宽阔的城市步行区域左侧可见带有拱门结构的古典砂岩建筑立面，街道两侧种有行道树并摆放着红色花卉长槽。室内商业拱廊右侧有带玻璃罩的柜台，左侧可见自动扶梯和“BALLY”招牌。"
      },
      {
        "index": 5,
        "title": "花园凉亭与池塘喷泉",
        "hero": "sydney_00_001777-f1",
        "main_gallery_count": 4,
        "highlight_count": 0,
        "episode_ids_in_main_gallery": [
          "E08"
        ],
        "story": "花园中有一座带尖顶屋顶和柱子的木制凉亭，周围环绕着草坪和灌木。一个平静的池塘中央有一个喷泉装置。"
      }
    ],
