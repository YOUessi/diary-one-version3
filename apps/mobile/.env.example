# Formal consumer App (Expo Go / package): BFF URL + Email OTP. No shared token.
# Auto-written by setup-commercial-dev.ps1 — restart Metro after change.
EXPO_PUBLIC_DEV_BFF_URL=http://10.192.251.97:8790
# EXPO_PUBLIC_BFF_BASE_URL=https://bff.your-domain.com

# Leave empty for formal App (OTP session only). Lab token only with ENABLE_LAB.
EXPO_PUBLIC_DEV_BFF_TOKEN=

# Engineer Lab only (Demo / Offline mock / Research / Skip). Default OFF.
# EXPO_PUBLIC_ENABLE_LAB=1
# EXPO_PUBLIC_ALLOW_MOCK_DIARY=1

# Google OAuth — unfinished; formal App hides OAuth unless Lab.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

