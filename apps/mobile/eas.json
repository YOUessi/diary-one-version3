{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_DEFAULT_BUNDLE_EXPORT": "V04",
        "EXPO_PUBLIC_INCLUDE_VISION": "1",
        "EXPO_PUBLIC_DEV_CLIENT": "1"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_INCLUDE_VISION": "1",
        "EXPO_PUBLIC_DEV_CLIENT": "1"
      }
    },
    "preview": {
      "distribution": "store",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_DEFAULT_BUNDLE_EXPORT": "V04",
        "EXPO_PUBLIC_STORE_RELEASE": "0",
        "EXPO_PUBLIC_INTERNAL_BETA": "1",
        "EXPO_PUBLIC_INCLUDE_VISION": "1",
        "EXPO_PUBLIC_DEV_BFF_URL": "https://bff.diary.luxe",
        "EXPO_PUBLIC_DEV_BFF_TOKEN": ""
      },
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_DEFAULT_BUNDLE_EXPORT": "V04",
        "EXPO_PUBLIC_STORE_RELEASE": "1",
        "EXPO_PUBLIC_INCLUDE_VISION": "1",
        "EXPO_PUBLIC_DEV_BFF_URL": "https://bff.diary.luxe",
        "EXPO_PUBLIC_DEV_BFF_TOKEN": ""
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID"
      }
    }
  }
}
