{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_DEFAULT_BUNDLE_EXPORT": "V04"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_DEFAULT_BUNDLE_EXPORT": "V04",
        "EXPO_PUBLIC_STORE_RELEASE": "0",
        "EXPO_PUBLIC_INTERNAL_BETA": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_DEFAULT_BUNDLE_EXPORT": "V04",
        "EXPO_PUBLIC_STORE_RELEASE": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
