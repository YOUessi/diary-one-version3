    "babel-preset-expo": "~57.0.0",
    "diary-one-vision": "file:./modules/diary-one-vision",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.19",
    "expo-auth-session": "~57.0.13",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-media-library": "~57.0.5",
    "expo-sharing": "~57.0.21",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.4",
    "expo-video-encoder": "^1.0.23",
    "expo-video-thumbnails": "~57.0.2",
    "expo-web-browser": "~57.0.3",
    "jpeg-js": "0.4.4",
    "onnxruntime-react-native": "1.24.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go --lan",
    "start:go": "expo start --go --lan",
    "start:tunnel": "expo start --go --tunnel",
    "android": "expo start --android --go",
    "ios": "expo start --ios --go",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "setup:android": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-android-windows.ps1",
    "eas:init": "eas init",
    "eas:build:ios:dev": "eas build --profile development --platform ios",
    "eas:build:ios:preview": "eas build --profile preview --platform ios",
    "eas:submit:ios:preview": "eas submit --platform ios --profile preview",
    "eas:build:ios:prod": "eas build --profile production --platform ios",
    "lint": "expo lint",
    "test:core": "node --test tests/*.test.cjs",
    "test:evidence": "node scripts/test-evidence.cjs",
    "test:onnx": "node --test scripts/test-onnx-lifecycle.cjs scripts/test-onnx-native-patch.cjs",
    "test:video-evidence": "node --test scripts/test-video-evidence.cjs scripts/test-main-algorithm-adapter.cjs",
    "test:video-native": "python3 scripts/test-video-native.py",
    "test:native-config": "node --test scripts/test-native-config.cjs"
  },
  "private": true
}
