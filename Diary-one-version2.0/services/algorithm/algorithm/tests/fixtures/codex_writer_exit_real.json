    "v148_attempt_1": {
      "locale": "zh-Hans",
      "writer_grounding_policy": "MODEL_GROUNDED_NATURAL_LANGUAGE_V02",
      "memories": [
        {
          "candidate_id": "ee127167-b73c-52c5-8276-2403d8cec1cd",
          "memory_type": "CHAPTER",
          "facts": [
            {
              "fact_id": "0f634a38-cd07-570e-91c8-9c6236b5adce",
              "text": "视频帧显示一座中式传统牌坊，横匾书有“種山巔秀”字样，两侧立柱挂有竖幅对联，下方为湿滑石板路及多个摊位、行人与电动车，背景可见灰瓦白墙建筑。"
            },
            {
              "fact_id": "fb09c82c-ea03-5bd7-86fd-f25df51e2ae8",
              "text": "一名穿灰色短袖上衣的男性背对镜头，沿湿滑石板路向画面深处行走，路旁停放多辆三轮车及电动车，其中一辆蓝色三轮车上载有白色泡沫箱与绿色网笼。"
            },
            {
              "fact_id": "14747127-4d09-55e9-bf8d-5428bb7b56f8",
              "text": "摊位上陈列多种蔬菜水果，包括成捆的绿色豆角、红番茄、黄瓜、竹笋、白芦笋、青苹果、桃子及橙色包装水果，部分置于白色泡沫箱内，地面湿润。"
            },
            {
              "fact_id": "6579ec1e-d236-5bfb-a86d-3370dff7a7c5",
              "text": "一名穿灰色衬衫的男子站在摆满蔬菜的摊位前，手部靠近嘴部；背景可见其他顾客及摊位。"
            },
            {
              "fact_id": "8fb3f0e4-7be6-5f8b-a446-efbce4ebab9f",
              "text": "一名男子坐在地上整理蔬菜，周围摆放着大量蔬菜，包括葱、萝卜、花生、胡萝卜等；地面为石板路。"
            },
            {
              "fact_id": "61027112-9124-556e-91bb-2a0ea4a34d6b",
              "text": "一名穿红蓝拼色上衣的男子蹲在木门旁，前方有蓝色桶装黑豆、白色泡沫箱装青瓜及红色立式广告牌。"
            },
            {
              "fact_id": "03b337cf-51d6-5e1a-982a-e6c9a68cad00",
              "text": "视频窗口早期帧显示白色帐篷摊位，前方有橙色灯笼悬挂，背景可见彩灯装饰与人群；中段帧展示摊位内操作台、桌布覆盖的桌面及一名穿深色上衣人员坐于后方；末段帧特写摊位前挡板上的“运汤 瑞阳宴集”字样，右侧陈列多支冰激凌甜筒，左侧可见标有“衢州烤饼”的发光招牌。"
            },
            {
              "fact_id": "fa170b03-4c8c-5833-b096-d117cca6e9e9",
              "text": "前景可见一个红色塑料盆盛满黄红相间的桃子，旁边白色篮中装有青色瓜类；背景为室内市场环境，地面为灰色地砖，远处货架陈列商品。"
            },
            {
              "fact_id": "6465e429-e79a-587f-9482-ebda46f328a2",
              "text": "画面展示市场内部通道，右侧台面堆满黄色柑橘类水果，后方货架整齐排列各类包装食品；左下角可见一张黄色促销地垫。"
            },
            {
              "fact_id": "b305dcf0-e125-5191-9c6d-fb2e14de308c",
              "text": "近景有两个白色椭圆盆，内装红黄混合的圆形水果；背景中有两名蹲姿人员正在处理绿色蔬菜，周围散落菜叶。"
            }
          ]
        },
        {
          "candidate_id": "f07c3c4a-cdcf-5385-a178-0fa9df8d2eda",
          "memory_type": "CHAPTER",
          "facts": [
            {
              "fact_id": "8949c6fc-e636-5880-8456-2662380331d5",
              "text": "视频帧显示一处悬挂大量红色祈福牌的木质结构，牌上附有红色流苏；另一帧显示一座石质阶梯桥，桥下有水道，旁置一石槽；最后一帧为一棵挂有红灯笼与祈福牌的树，树干下半部被涂白，背景有白墙黑瓦建筑。"
            },
            {
              "fact_id": "dd91db3d-28a1-52a7-ba6a-e99f091b20b6",
              "text": "一条由不规则石板铺成的蜿蜒小径穿过林地，两侧为密集树木，地面覆盖枯叶。"
            },
            {
              "fact_id": "9593f8e4-47af-5369-81c5-e0c6c62382dc",
              "text": "一只棕白相间的狗背对镜头沿石板路向前行走，身披浅色背带。"
            },
            {
              "fact_id": "f2467e7d-2d51-58d3-b9fd-cedff630111d",
              "text": "林间铺有青石板台阶，两侧覆盖落叶与低矮灌木，远处可见延伸的步道及树木。"
            }
          ]
        },
        {
          "candidate_id": "7f1d4d69-e287-5551-8c83-4b935de9c673",
          "memory_type": "CHAPTER",
          "facts": [
            {
              "fact_id": "9e75ecaf-42fe-5006-8151-c0065cd28963",
              "text": "一条铺有石板的巷道通向一座中式牌坊，牌坊上有“禹贡古村”字样，两侧挂有红灯笼，周围绿树环绕。"
            },
            {
              "fact_id": "ca84b156-b02e-59a0-9731-fef2acd61cff",
              "text": "牌坊右侧设有一个小摊位，白色柜体上写有“臭豆腐”字样，旁边立有彩色花束装饰及宣传画板。"
            },
            {
              "fact_id": "8c6fe5ef-b4a5-5e8c-a9b0-7a71a76250a2",
              "text": "视频窗口早期帧显示石板庭院、白墙灰瓦建筑及红色祈福牌，中段帧可见正门上方黑底金字牌匾，末段帧视角转向另一侧带红灯笼的入口，整体为传统中式院落场景。"
            },
            {
              "fact_id": "f67f91d2-a826-51f7-993c-b40e61edf441",
              "text": "一只棕白相间的长毛犬身穿浅蓝色背心，正沿着铺有青石板的街道向前奔跑；街道两侧为白墙灰瓦建筑，墙上覆盖大量绿植。"
            },
            {
              "fact_id": "b4c59a46-c720-559c-b2a0-a14d272b22e2",
              "text": "同一街道场景中，一只同款犬只在镜头前转向移动，画面右下角可见一人手臂及黑色腕带；背景为店铺门面与盆栽植物。"
            },
            {
              "fact_id": "45a87c7f-6cec-599e-b1fb-7815f7b81e66",
              "text": "一辆白色四座电动观光车停靠于街边，车体印有黑色汉字；车内坐有一名穿深绿色上衣者，车辆位于石板路面上。"
            },
            {
              "fact_id": "f65d1532-1479-51b7-9981-ee93c994a44a",
              "text": "画面呈现一家店铺门面，灰墙黑瓦，双开玻璃门上贴有红色“福”字装饰，门旁立有黑色石雕与盆栽；门前地面为不规则石板铺就。"
            }
          ]
        },
