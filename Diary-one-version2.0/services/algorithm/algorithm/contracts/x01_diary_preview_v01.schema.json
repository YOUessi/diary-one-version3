{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diary.one/contracts/x01_diary_preview_v01.schema.json",
  "title": "Diary One X01 Diary Research Preview V01",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment",
    "experimental",
    "leaderboard_eligible",
    "session_id",
    "bundle_manifest_sha256",
    "output_mode",
    "timeline_date",
    "observations",
    "moments",
    "chapters",
    "ahas",
    "decision_trace",
    "trace"
  ],
  "properties": {
    "schema_version": { "const": "DIARY_ONE_X01_PREVIEW_V01" },
    "experiment": { "const": "X01_DIARY_RESEARCH_PREVIEW" },
    "experimental": { "const": true },
    "leaderboard_eligible": { "const": false },
    "session_id": { "type": "string", "format": "uuid" },
    "bundle_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "output_mode": { "enum": ["CHAPTER_DAY", "HIGHLIGHT_DAY", "EMPTY_DAY"] },
    "timeline_date": { "type": "string", "format": "date-time" },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    },
    "moments": {
      "type": "array",
      "items": { "$ref": "#/$defs/moment" }
    },
    "chapters": {
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "#/$defs/editorial" }
    },
    "ahas": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/editorial" }
    },
    "decision_trace": { "$ref": "#/$defs/decisionTrace" },
    "trace": { "$ref": "#/$defs/trace" }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "asset_id", "evidence_frame_ids", "observed_facts", "uncertainty", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "asset_id": { "type": "string", "format": "uuid" },
        "evidence_frame_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_facts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "uncertainty": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "claim_type", "evidence_frame_ids"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "claim_type": { "enum": ["OBSERVED", "DERIVED"] },
        "evidence_frame_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "moment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "asset_id", "time_label", "caption", "confidence", "evidence_frame_ids"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "asset_id": { "type": "string", "format": "uuid" },
        "time_label": { "type": "string", "minLength": 1 },
        "caption": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_frame_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "editorial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "time_label",
        "story",
        "tags",
        "moment_ids",
        "hero_asset_id",
        "confidence",
        "evidence_frame_ids",
        "claims"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "title": { "type": "string", "minLength": 1 },
        "time_label": { "type": "string", "minLength": 1 },
        "story": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "moment_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uuid" }
        },
        "hero_asset_id": { "type": "string", "format": "uuid" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_frame_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claim" }
        }
      }
    },
    "decisionTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_type",
        "contains_hidden_reasoning",
        "scope_note",
        "evidence_selection",
        "counts",
        "observation_candidates",
        "moment_candidates",
        "chapter_candidates",
        "aha_candidates"
      ],
      "properties": {
        "trace_type": { "const": "AUDITABLE_DECISION_EVIDENCE" },
        "contains_hidden_reasoning": { "const": false },
        "scope_note": { "type": "string", "minLength": 1 },
        "evidence_selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "available_frame_count",
            "model_frame_count",
            "reported_selected_frame_count",
            "adapter_reported_selection",
            "selected"
          ],
          "properties": {
            "strategy": { "type": "string", "minLength": 1 },
            "available_frame_count": { "type": "integer", "minimum": 1 },
            "model_frame_count": { "type": "integer", "minimum": 1 },
            "reported_selected_frame_count": { "type": "integer", "minimum": 0 },
            "adapter_reported_selection": { "type": "boolean" },
            "selected": {
              "type": "array",
              "items": { "$ref": "#/$defs/selectedEvidence" }
            }
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "observation_candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/observationDecision" }
        },
        "moment_candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/momentDecision" }
        },
        "chapter_candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/candidateDecision" }
        },
        "aha_candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/candidateDecision" }
        }
      }
    },
    "selectedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_order",
        "asset_id",
        "source_asset_id",
        "frame_id",
        "media_kind",
        "canonical_offset_ms",
        "reason_code"
      ],
      "properties": {
        "selection_order": { "type": "integer", "minimum": 0 },
        "asset_id": { "type": "string", "format": "uuid" },
        "source_asset_id": { "type": "string", "minLength": 1 },
        "frame_id": { "type": "string", "minLength": 1 },
        "media_kind": { "enum": ["PHOTO", "VIDEO"] },
        "canonical_offset_ms": { "type": "integer", "minimum": 0 },
        "reason_code": { "type": "string", "minLength": 1 }
      }
    },
    "observationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_index",
        "source_asset_id",
        "confidence",
        "evidence_frame_ids",
        "invalid_frame_ids",
        "validation_status",
        "reason_code",
        "reason_codes"
      ],
      "properties": {
        "source_index": { "type": "integer", "minimum": 0 },
        "source_asset_id": { "type": ["string", "null"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "evidence_frame_ids": { "type": "array", "items": { "type": "string" } },
        "invalid_frame_ids": { "type": "array", "items": { "type": "string" } },
        "validation_status": { "enum": ["PENDING", "PASSED", "REJECTED"] },
        "reason_code": { "type": ["string", "null"] },
        "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "candidateDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_kind",
        "source_index",
        "source_key",
        "candidate_id",
        "title",
        "story",
        "confidence",
        "source_asset_ids",
        "evidence_frame_ids",
        "validation_status",
        "selection_status",
        "reason_code",
        "reason_codes"
      ],
      "properties": {
        "candidate_kind": { "enum": ["CHAPTER", "AHA"] },
        "source_index": { "type": "integer", "minimum": 0 },
        "source_key": { "type": ["string", "null"] },
        "candidate_id": { "type": ["string", "null"], "format": "uuid" },
        "title": { "type": "string" },
        "story": { "type": "string" },
        "confidence": { "type": ["number", "null"] },
        "source_asset_ids": { "type": "array", "items": { "type": "string" } },
        "evidence_frame_ids": { "type": "array", "items": { "type": "string" } },
        "validation_status": { "enum": ["PENDING", "PASSED", "REJECTED"] },
        "selection_status": { "enum": ["NOT_ELIGIBLE", "PENDING", "SELECTED", "NOT_SELECTED"] },
        "reason_code": { "type": ["string", "null"] },
        "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "momentDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_index",
        "source_key",
        "confidence",
        "source_asset_ids",
        "materialized_asset_ids",
        "evidence_frame_ids",
        "validation_status",
        "materialization_status",
        "reason_code",
        "reason_codes"
      ],
      "properties": {
        "source_index": { "type": "integer", "minimum": 0 },
        "source_key": { "type": ["string", "null"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "source_asset_ids": { "type": "array", "items": { "type": "string" } },
        "materialized_asset_ids": { "type": "array", "items": { "type": "string" } },
        "evidence_frame_ids": { "type": "array", "items": { "type": "string" } },
        "validation_status": { "enum": ["PENDING", "PASSED", "REJECTED"] },
        "materialization_status": {
          "enum": ["NOT_ELIGIBLE", "PENDING", "MATERIALIZED", "PARTIALLY_MATERIALIZED", "NOT_MATERIALIZED"]
        },
        "reason_code": { "type": ["string", "null"] },
        "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "stageMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "duration_ms", "model_calls", "input_tokens", "output_tokens", "estimated_cost_usd"],
      "properties": {
        "stage": {
          "enum": ["BUNDLE_LOAD", "EDITORIAL_MODEL_BRIDGE", "DETERMINISTIC_VALIDATION_SELECTION"]
        },
        "duration_ms": { "type": "number", "minimum": 0 },
        "model_calls": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "estimated_cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_version",
        "provider",
        "model",
        "request_id",
        "model_calls",
        "asset_count",
        "evidence_frame_count",
        "model_frame_count",
        "uploaded_bytes",
        "originals_uploaded",
        "input_tokens",
        "output_tokens",
        "latency_seconds",
        "estimated_cost_usd",
        "pricing",
        "stage_metrics",
        "total_duration_ms",
        "stage_metric_scope"
      ],
      "properties": {
        "pipeline_version": { "const": "X01_DIARY_RESEARCH_PREVIEW_V01" },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 },
        "model_calls": { "type": "integer", "minimum": 0 },
        "asset_count": { "type": "integer", "minimum": 1 },
        "evidence_frame_count": { "type": "integer", "minimum": 1 },
        "model_frame_count": { "type": "integer", "minimum": 1 },
        "uploaded_bytes": { "type": "integer", "minimum": 0 },
        "originals_uploaded": { "const": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "latency_seconds": { "type": "number", "minimum": 0 },
        "estimated_cost_usd": { "type": "number", "minimum": 0 },
        "stage_metrics": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/stageMetric" }
        },
        "total_duration_ms": { "type": "number", "minimum": 0 },
        "stage_metric_scope": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "format": "uuid" },
        "completed_at": { "type": "string", "format": "date-time" },
        "server_total_before_audit_ms": { "type": "number", "minimum": 0 },
        "server_metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "duration_ms", "request_body_bytes"],
            "properties": {
              "stage": { "const": "REQUEST_MULTIPART_MATERIALIZATION" },
              "duration_ms": { "type": "number", "minimum": 0 },
              "request_body_bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "pricing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "currency",
            "input_rate_per_million",
            "output_rate_per_million",
            "native_currency_per_usd",
            "estimated_cost_native",
            "basis"
          ],
          "properties": {
            "currency": { "enum": ["USD", "CNY"] },
            "input_rate_per_million": { "type": "number", "minimum": 0 },
            "output_rate_per_million": { "type": "number", "minimum": 0 },
            "native_currency_per_usd": { "type": "number", "exclusiveMinimum": 0 },
            "estimated_cost_native": { "type": "number", "minimum": 0 },
            "basis": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
