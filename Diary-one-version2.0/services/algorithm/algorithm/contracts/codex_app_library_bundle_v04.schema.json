{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diary.one/contracts/codex_app_library_bundle_v04.schema.json",
  "title": "Diary One Phone-library Full-frame Test Bundle V04",
  "description": "V04 preserves the complete source frame via aspect-fit letterboxing on a 768x1024 canvas. All V03 sequence-only and temporal sampling fields remain unchanged; V03 remains center-cropped.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_version",
    "research_only",
    "session",
    "device",
    "normalization",
    "assets"
  ],
  "properties": {
    "bundle_version": {
      "const": "DIARY_ONE_APP_LIBRARY_BUNDLE_V04"
    },
    "research_only": {
      "const": true
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "exported_at",
        "timezone"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "exported_at": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "hardware_revision",
        "firmware_version",
        "sdk_version"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1
        },
        "hardware_revision": {
          "type": "string",
          "minLength": 1
        },
        "firmware_version": {
          "type": "string",
          "minLength": 1
        },
        "sdk_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "orientation",
        "aspect_ratio",
        "spatial_transform",
        "temporal_transform",
        "canonical_frame_offsets_ms",
        "evidence_profile_version"
      ],
      "properties": {
        "width": {
          "const": 768
        },
        "height": {
          "const": 1024
        },
        "orientation": {
          "const": "PORTRAIT"
        },
        "aspect_ratio": {
          "const": "3:4"
        },
        "spatial_transform": {
          "const": "ASPECT_FIT_LETTERBOX"
        },
        "temporal_transform": {
          "const": "PHONE_TEST_DURATION_WINDOWS_V01"
        },
        "canonical_frame_offsets_ms": {
          "const": [
            1500,
            4500,
            7500
          ]
        },
        "evidence_profile_version": {
          "const": "PHONE_TEST_DURATION_WINDOWS_V01"
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "window_index",
        "window_count",
        "sample_role",
        "canonical_offset_ms",
        "source_timestamp_ms",
        "relative_path",
        "sha256",
        "width",
        "height",
        "spatial_transform"
      ],
      "properties": {
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "window_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "window_count": {
          "enum": [
            1,
            2,
            4,
            6
          ]
        },
        "sample_role": {
          "enum": [
            "PHOTO_REPRESENTATIVE",
            "WINDOW_EARLY",
            "WINDOW_MIDDLE",
            "WINDOW_LATE"
          ]
        },
        "canonical_offset_ms": {
          "enum": [
            1500,
            4500,
            7500
          ]
        },
        "source_timestamp_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Clip-relative sampling offset inside this one source asset only. It is not capture time, day time, or evidence of a gap between assets."
        },
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "width": {
          "const": 768
        },
        "height": {
          "const": 1024
        },
        "spatial_transform": {
          "const": "ASPECT_FIT_LETTERBOX"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "media_kind",
        "media_source",
        "original_file_extension",
        "original_sha256",
        "original_bytes",
        "original_width",
        "original_height",
        "original_duration_ms",
        "original_included",
        "sequence_index",
        "logical_asset_duration_ms",
        "materialized_video",
        "evidence_sampling_profile",
        "evidence_window_count",
        "frames"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "source_display_name": {
          "type": "string"
        },
        "media_kind": {
          "enum": [
            "PHOTO",
            "VIDEO"
          ]
        },
        "media_source": {
          "const": "PHONE_LIBRARY_DAY_TEST"
        },
        "original_file_extension": {
          "type": "string",
          "minLength": 1
        },
        "original_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "original_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "original_width": {
          "type": "integer",
          "minimum": 1
        },
        "original_height": {
          "type": "integer",
          "minimum": 1
        },
        "original_duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "original_included": {
          "const": false
        },
        "sequence_index": {
          "type": "integer",
          "minimum": 0,
          "description": "Must equal this asset's zero-based position in the assets array; continuity and order are validated by the bundle loader."
        },
        "logical_asset_duration_ms": {
          "const": 9000,
          "description": "Canonical Evidence normalization parameter only. It is not the source duration and must never be used as capture time or cross-asset elapsed time."
        },
        "materialized_video": {
          "const": false
        },
        "evidence_sampling_profile": {
          "enum": [
            "PHOTO_SINGLE_FRAME",
            "VIDEO_SINGLE_WINDOW_THREE",
            "VIDEO_MULTI_WINDOW_TWO_PER_WINDOW"
          ]
        },
        "evidence_window_count": {
          "enum": [
            1,
            2,
            4,
            6
          ]
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/frame"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "media_kind": {
              "const": "PHOTO"
            },
            "original_duration_ms": {
              "const": null
            },
            "evidence_sampling_profile": {
              "const": "PHOTO_SINGLE_FRAME"
            },
            "evidence_window_count": {
              "const": 1
            },
            "frames": {
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/frame"
                  },
                  {
                    "properties": {
                      "source_timestamp_ms": {
                        "const": null
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "properties": {
            "media_kind": {
              "const": "VIDEO"
            },
            "original_duration_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "evidence_sampling_profile": {
              "const": "VIDEO_SINGLE_WINDOW_THREE"
            },
            "evidence_window_count": {
              "const": 1
            },
            "frames": {
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/frame"
                  },
                  {
                    "properties": {
                      "source_timestamp_ms": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "properties": {
            "media_kind": {
              "const": "VIDEO"
            },
            "original_duration_ms": {
              "type": "integer",
              "minimum": 10001,
              "maximum": 30000
            },
            "evidence_sampling_profile": {
              "const": "VIDEO_MULTI_WINDOW_TWO_PER_WINDOW"
            },
            "evidence_window_count": {
              "const": 2
            },
            "frames": {
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/frame"
                  },
                  {
                    "properties": {
                      "source_timestamp_ms": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "properties": {
            "media_kind": {
              "const": "VIDEO"
            },
            "original_duration_ms": {
              "type": "integer",
              "minimum": 30001,
              "maximum": 90000
            },
            "evidence_sampling_profile": {
              "const": "VIDEO_MULTI_WINDOW_TWO_PER_WINDOW"
            },
            "evidence_window_count": {
              "const": 4
            },
            "frames": {
              "minItems": 8,
              "maxItems": 8,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/frame"
                  },
                  {
                    "properties": {
                      "source_timestamp_ms": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "properties": {
            "media_kind": {
              "const": "VIDEO"
            },
            "original_duration_ms": {
              "type": "integer",
              "minimum": 90001
            },
            "evidence_sampling_profile": {
              "const": "VIDEO_MULTI_WINDOW_TWO_PER_WINDOW"
            },
            "evidence_window_count": {
              "const": 6
            },
            "frames": {
              "minItems": 12,
              "maxItems": 12,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/frame"
                  },
                  {
                    "properties": {
                      "source_timestamp_ms": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
