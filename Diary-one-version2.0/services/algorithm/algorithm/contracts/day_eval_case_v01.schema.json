{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexleap.tech/contracts/diary-one/day-eval-case-v01.schema.json",
  "title": "Diary One Day Eval Case V01",
  "type": "object",
  "required": [
    "contract_version",
    "day_id",
    "title",
    "profile_id",
    "evidence_mode",
    "timeline_step_minutes",
    "timeline",
    "gold",
    "human_review_prompts"
  ],
  "properties": {
    "contract_version": {"const": "DIARY_ONE_DAY_EVAL_CASE_V01"},
    "day_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "evidence_mode": {"const": "SEMANTIC_TIMELINE_ONLY"},
    "timeline_step_minutes": {"const": 2},
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/timelineWindow"}
    },
    "gold": {"$ref": "#/$defs/gold"},
    "human_review_prompts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringSet": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "nonEmptyStringSet": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "range": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "timelineWindow": {
      "type": "object",
      "required": [
        "window_id",
        "capture_minute",
        "source_kind",
        "semantic_atoms",
        "evidence_support"
      ],
      "properties": {
        "window_id": {"type": "string", "minLength": 1},
        "capture_minute": {"type": "integer", "minimum": 0, "maximum": 1439},
        "source_kind": {
          "enum": ["AUTO", "MANUAL_PHOTO", "MANUAL_VIDEO"]
        },
        "semantic_atoms": {"$ref": "#/$defs/stringSet"},
        "evidence_support": {
          "enum": ["STRONG", "MODERATE", "WEAK", "UNKNOWN"]
        },
        "import_batch_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "goldMemory": {
      "type": "object",
      "required": [
        "gold_memory_id",
        "memory_type",
        "requirement",
        "story_role",
        "acceptable_span_minute",
        "minimum_overlap_ratio",
        "identity_atoms",
        "required_atoms",
        "optional_atoms",
        "forbidden_atoms",
        "required_concept_ids",
        "allowed_concept_ids",
        "forbidden_concept_ids",
        "allowed_entity_ids",
        "media_policy",
        "media_count_range",
        "required_media_atoms",
        "allowed_media_formats"
      ],
      "properties": {
        "gold_memory_id": {"type": "string", "minLength": 1},
        "memory_type": {"enum": ["CHAPTER", "AHA"]},
        "requirement": {"enum": ["REQUIRED", "OPTIONAL_REVIEW"]},
        "story_role": {"type": "string", "minLength": 1},
        "acceptable_span_minute": {"$ref": "#/$defs/range"},
        "minimum_overlap_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "identity_atoms": {"$ref": "#/$defs/nonEmptyStringSet"},
        "required_atoms": {"$ref": "#/$defs/stringSet"},
        "optional_atoms": {"$ref": "#/$defs/stringSet"},
        "forbidden_atoms": {"$ref": "#/$defs/stringSet"},
        "required_concept_ids": {"$ref": "#/$defs/stringSet"},
        "allowed_concept_ids": {"$ref": "#/$defs/stringSet"},
        "forbidden_concept_ids": {"$ref": "#/$defs/stringSet"},
        "allowed_entity_ids": {"$ref": "#/$defs/stringSet"},
        "media_policy": {
          "enum": ["STANDARD_3_TO_5", "COMPACT_2_TO_5", "AHA_SINGLE"]
        },
        "compact_pair_gate_ref": {"type": "string", "minLength": 1},
        "media_count_range": {"$ref": "#/$defs/range"},
        "required_media_atoms": {"$ref": "#/$defs/stringSet"},
        "allowed_media_formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["PHOTO", "LIVE_2S", "VIDEO_5S"]}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"media_policy": {"const": "STANDARD_3_TO_5"}},
            "required": ["media_policy"]
          },
          "then": {
            "properties": {
              "memory_type": {"const": "CHAPTER"},
              "media_count_range": {
                "prefixItems": [{"const": 3}, {"const": 5}]
              }
            }
          }
        },
        {
          "if": {
            "properties": {"media_policy": {"const": "COMPACT_2_TO_5"}},
            "required": ["media_policy"]
          },
          "then": {
            "required": ["compact_pair_gate_ref"],
            "properties": {
              "memory_type": {"const": "CHAPTER"},
              "media_count_range": {
                "prefixItems": [{"const": 2}, {"const": 5}]
              }
            }
          }
        },
        {
          "if": {
            "properties": {"media_policy": {"const": "AHA_SINGLE"}},
            "required": ["media_policy"]
          },
          "then": {
            "properties": {
              "memory_type": {"const": "AHA"},
              "media_count_range": {
                "prefixItems": [{"const": 1}, {"const": 1}]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "forbiddenMemoryPattern": {
      "type": "object",
      "required": ["memory_type", "any_atoms", "error_code"],
      "properties": {
        "memory_type": {"enum": ["CHAPTER", "AHA"]},
        "any_atoms": {"$ref": "#/$defs/nonEmptyStringSet"},
        "error_code": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "distinctStoryPair": {
      "type": "object",
      "required": [
        "chapter_gold_id",
        "aha_gold_id",
        "chapter_forbidden_atoms",
        "aha_forbidden_atoms"
      ],
      "properties": {
        "chapter_gold_id": {"type": "string", "minLength": 1},
        "aha_gold_id": {"type": "string", "minLength": 1},
        "chapter_forbidden_atoms": {"$ref": "#/$defs/stringSet"},
        "aha_forbidden_atoms": {"$ref": "#/$defs/stringSet"}
      },
      "additionalProperties": false
    },
    "gold": {
      "type": "object",
      "required": [
        "label_origin",
        "label_status",
        "accuracy_eligible",
        "day_state",
        "chapter_count_range",
        "aha_count_range",
        "memories",
        "forbidden_memory_patterns",
        "distinct_story_pairs"
      ],
      "properties": {
        "label_origin": {
          "enum": ["DESIGN_GOLD", "HUMAN_ADJUDICATED_GOLD"]
        },
        "label_status": {
          "enum": ["DESIGN_REVIEWED", "HUMAN_ADJUDICATED"]
        },
        "accuracy_eligible": {"type": "boolean"},
        "independent_annotator_count": {"type": "integer", "minimum": 0},
        "adjudication_ref": {"type": "string"},
        "day_state": {
          "enum": ["CHAPTER_DAY", "HIGHLIGHT_DAY", "EMPTY_DAY"]
        },
        "chapter_count_range": {"$ref": "#/$defs/range"},
        "aha_count_range": {"$ref": "#/$defs/range"},
        "memories": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/goldMemory"}
        },
        "forbidden_memory_patterns": {
          "type": "array",
          "items": {"$ref": "#/$defs/forbiddenMemoryPattern"}
        },
        "distinct_story_pairs": {
          "type": "array",
          "items": {"$ref": "#/$defs/distinctStoryPair"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"label_origin": {"const": "DESIGN_GOLD"}},
            "required": ["label_origin"]
          },
          "then": {
            "properties": {
              "label_status": {"const": "DESIGN_REVIEWED"},
              "accuracy_eligible": {"const": false}
            }
          }
        },
        {
          "if": {
            "properties": {
              "label_origin": {"const": "HUMAN_ADJUDICATED_GOLD"}
            },
            "required": ["label_origin"]
          },
          "then": {
            "required": ["independent_annotator_count", "adjudication_ref"],
            "properties": {
              "label_status": {"const": "HUMAN_ADJUDICATED"},
              "accuracy_eligible": {"const": true},
              "independent_annotator_count": {"type": "integer", "minimum": 2},
              "adjudication_ref": {"type": "string", "minLength": 1}
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
