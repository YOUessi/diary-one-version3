{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexleap.tech/contracts/diary-one/validation-suite-v01.schema.json",
  "title": "Diary One Validation Suite V01",
  "type": "object",
  "required": [
    "contract_version",
    "suite_id",
    "title",
    "evidence_scope",
    "narrative_locale",
    "pipeline_contract_ref",
    "days",
    "trials"
  ],
  "properties": {
    "contract_version": {"const": "DIARY_ONE_VALIDATION_SUITE_V01"},
    "suite_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "title": {"type": "string", "minLength": 1},
    "evidence_scope": {"const": "SEMANTIC_TIMELINE_ONLY"},
    "narrative_locale": {"const": "zh-CN"},
    "pipeline_contract_ref": {"const": "DIARY_ONE_PRODUCTION_PIPELINE_V1_0"},
    "days": {
      "type": "array",
      "minItems": 12,
      "maxItems": 20,
      "items": {
        "$ref": "day_eval_case_v01.schema.json"
      }
    },
    "trials": {
      "type": "array",
      "minItems": 12,
      "items": {"$ref": "#/$defs/trial"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringSet": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "range": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "media": {
      "type": "object",
      "required": ["media_id", "semantic_atom", "format", "is_hero"],
      "properties": {
        "media_id": {"type": "string", "minLength": 1},
        "semantic_atom": {"type": "string", "minLength": 1},
        "format": {"enum": ["PHOTO", "LIVE_2S", "VIDEO_5S"]},
        "is_hero": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "narrative": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "story": {"type": "string"},
        "moment_line": {"type": "string"},
        "time_label": {"type": "string"},
        "title_soft_extension_reason": {"type": "string"},
        "second_sentence_increment_atom": {"type": "string"}
      },
      "additionalProperties": false
    },
    "predictionMemory": {
      "type": "object",
      "required": [
        "memory_id",
        "memory_type",
        "span_minute",
        "semantic_atoms",
        "asserted_atoms",
        "canonical_concept_ids",
        "entity_ids",
        "media",
        "narrative"
      ],
      "properties": {
        "memory_id": {"type": "string", "minLength": 1},
        "memory_type": {"enum": ["CHAPTER", "AHA"]},
        "span_minute": {"$ref": "#/$defs/range"},
        "semantic_atoms": {"$ref": "#/$defs/stringSet"},
        "asserted_atoms": {"$ref": "#/$defs/stringSet"},
        "canonical_concept_ids": {"$ref": "#/$defs/stringSet"},
        "entity_ids": {"$ref": "#/$defs/stringSet"},
        "media": {
          "type": "array",
          "items": {"$ref": "#/$defs/media"}
        },
        "narrative": {"$ref": "#/$defs/narrative"}
      },
      "additionalProperties": false
    },
    "prediction": {
      "type": "object",
      "required": ["day_state", "memories"],
      "properties": {
        "day_state": {
          "enum": ["CHAPTER_DAY", "HIGHLIGHT_DAY", "EMPTY_DAY"]
        },
        "memories": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/predictionMemory"}
        }
      },
      "additionalProperties": false
    },
    "expectedEvaluation": {
      "type": "object",
      "required": ["status", "required_error_codes"],
      "properties": {
        "status": {
          "enum": ["PASS", "REVIEW", "QUALITY_FAIL", "BLOCKING_FAIL"]
        },
        "required_error_codes": {"$ref": "#/$defs/stringSet"}
      },
      "additionalProperties": false
    },
    "trial": {
      "type": "object",
      "required": [
        "trial_id",
        "day_id",
        "trial_kind",
        "prediction",
        "expected_evaluation"
      ],
      "properties": {
        "trial_id": {"type": "string", "minLength": 1},
        "day_id": {"type": "string", "minLength": 1},
        "trial_kind": {
          "enum": ["NOMINAL_REFERENCE", "FAILURE_INJECTION"]
        },
        "prediction": {"$ref": "#/$defs/prediction"},
        "expected_evaluation": {"$ref": "#/$defs/expectedEvaluation"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"trial_kind": {"const": "FAILURE_INJECTION"}},
            "required": ["trial_kind"]
          },
          "then": {
            "properties": {
              "expected_evaluation": {
                "properties": {
                  "status": {"enum": ["QUALITY_FAIL", "BLOCKING_FAIL"]},
                  "required_error_codes": {"minItems": 1}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"trial_kind": {"const": "NOMINAL_REFERENCE"}},
            "required": ["trial_kind"]
          },
          "then": {
            "properties": {
              "expected_evaluation": {
                "properties": {
                  "status": {"enum": ["PASS", "REVIEW"]}
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
