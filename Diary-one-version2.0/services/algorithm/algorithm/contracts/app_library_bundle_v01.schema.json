{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diary.one/contracts/app_library_bundle_v01.schema.json",
  "title": "Diary One App Library Bundle V01",
  "type": "object",
  "required": ["bundle_version", "research_only", "session", "device", "normalization", "assets"],
  "properties": {
    "bundle_version": {"const": "DIARY_ONE_APP_LIBRARY_BUNDLE_V01"},
    "research_only": {"const": true},
    "session": {
      "type": "object",
      "required": ["session_id", "exported_at", "timezone"]
    },
    "device": {
      "type": "object",
      "required": ["device_id", "hardware_revision", "firmware_version", "sdk_version"]
    },
    "normalization": {
      "type": "object",
      "required": ["width", "height", "orientation", "aspect_ratio", "spatial_transform", "temporal_transform", "canonical_frame_offsets_ms"],
      "properties": {
        "width": {"const": 768},
        "height": {"const": 1024},
        "orientation": {"const": "PORTRAIT"},
        "aspect_ratio": {"const": "3:4"},
        "spatial_transform": {"const": "CENTER_CROP_ASPECT_FILL"},
        "temporal_transform": {"const": "NORMALIZED_FRACTIONS_TO_CANONICAL_9S"},
        "canonical_frame_offsets_ms": {"const": [1500, 4500, 7500]}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "media_kind", "original_sha256", "original_bytes", "original_width", "original_height", "original_included", "timeline_offset_ms", "logical_asset_duration_ms", "materialized_video", "frames"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "media_kind": {"enum": ["PHOTO", "VIDEO"]},
          "original_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "original_bytes": {"type": "integer", "minimum": 0},
          "original_width": {"type": "integer", "minimum": 1},
          "original_height": {"type": "integer", "minimum": 1},
          "original_duration_ms": {"type": ["integer", "null"], "minimum": 1},
          "original_included": {"const": false},
          "timeline_offset_ms": {"type": "integer", "minimum": 0},
          "logical_asset_duration_ms": {"const": 9000},
          "materialized_video": {"const": false},
          "frames": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["frame_id", "canonical_offset_ms", "source_timestamp_ms", "relative_path", "sha256", "width", "height", "spatial_transform"],
              "properties": {
                "frame_id": {"type": "string", "minLength": 1},
                "canonical_offset_ms": {"enum": [1500, 4500, 7500]},
                "source_timestamp_ms": {"type": ["integer", "null"], "minimum": 0},
                "relative_path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "width": {"const": 768},
                "height": {"const": 1024},
                "spatial_transform": {"const": "CENTER_CROP_ASPECT_FILL"}
              }
            }
          }
        }
      }
    }
  }
}

