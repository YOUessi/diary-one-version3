{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexleap.tech/contracts/x02_staged_preview_v03.schema.json",
  "title": "Diary One X02 Staged Real-Media Preview V03",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment", "experimental", "leaderboard_eligible",
    "production_ready", "observation_semantic_contract_version",
    "observation_semantic_contract_sha256", "field_degradation_contract_version",
    "field_degradation_contract_sha256", "evaluation_run_mode",
    "cross_run_semantic_cache_used", "session_id", "bundle_manifest_sha256",
    "output_mode", "timeline_date", "observations", "moments", "chapters",
    "ahas", "decision_trace", "trace"
  ],
  "properties": {
    "schema_version": {"const": "DIARY_ONE_X02_STAGED_PREVIEW_V03"},
    "experiment": {"const": "X02_STAGED_REAL_MEDIA_PREVIEW"},
    "experimental": {"const": true},
    "leaderboard_eligible": {"const": false},
    "production_ready": {"const": false},
    "observation_semantic_contract_version": {"const": "DIARY_ONE_X02_OBSERVATION_COMPATIBILITY_V02"},
    "observation_semantic_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "field_degradation_contract_version": {"const": "DIARY_ONE_X02_FIELD_DEGRADATION_V01"},
    "field_degradation_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluation_run_mode": {"const": "FRESH_FULL_RUN"},
    "cross_run_semantic_cache_used": {"const": false},
    "session_id": {"type": "string", "format": "uuid"},
    "bundle_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_mode": {"enum": ["CHAPTER_DAY", "HIGHLIGHT_DAY", "EMPTY_DAY", "PIPELINE_BLOCKED"]},
    "timeline_date": {"type": "string"},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "moments": {"type": "array", "items": {"$ref": "#/$defs/moment"}},
    "chapters": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/memory"}},
    "ahas": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/memory"}},
    "decision_trace": {
      "type": "object",
      "required": [
        "trace_type", "contains_hidden_reasoning", "scope_note", "stage_statuses",
        "evidence_selection", "observation_candidates", "boundary_edges",
        "observation_roles", "chapter_candidates", "aha_candidates",
        "chapter_set_selection", "aha_set_selection", "s10_chapter_media",
        "s10_aha_media", "writer_items", "blocked_memories", "counts"
      ]
    },
    "trace": {
      "type": "object",
      "required": [
        "run_id", "pipeline_version", "execution_mode", "evaluation_run_mode",
        "cross_run_semantic_cache_used", "input_bundle_version",
        "evidence_profile_version", "provider", "model", "request_id",
        "request_ids", "model_calls", "asset_count", "evidence_frame_count",
        "model_frame_count", "uploaded_bytes", "originals_uploaded",
        "input_tokens", "output_tokens", "latency_seconds", "estimated_cost_usd",
        "stage_metrics", "total_duration_ms", "stage_metric_scope", "s13_status"
      ],
      "properties": {
        "run_id": {"type": "string", "format": "uuid"},
        "pipeline_version": {"const": "X02_STAGED_REAL_MEDIA_PREVIEW_V03"},
        "execution_mode": {"const": "STAGED_REAL_MEDIA_PREVIEW_NOT_PRODUCTION"},
        "evaluation_run_mode": {"const": "FRESH_FULL_RUN"},
        "cross_run_semantic_cache_used": {"const": false},
        "input_bundle_version": {"enum": ["DIARY_ONE_APP_LIBRARY_BUNDLE_V01", "DIARY_ONE_APP_LIBRARY_BUNDLE_V02"]},
        "evidence_profile_version": {"type": "string"},
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "request_id": {"type": "string"},
        "request_ids": {"type": "array", "items": {"type": "string"}},
        "model_calls": {"type": "integer", "minimum": 0},
        "asset_count": {"type": "integer", "minimum": 1},
        "evidence_frame_count": {"type": "integer", "minimum": 1},
        "model_frame_count": {"type": "integer", "minimum": 0},
        "uploaded_bytes": {"type": "integer", "minimum": 0},
        "model_evidence_bytes": {"type": "integer", "minimum": 0},
        "originals_uploaded": {"const": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "latency_seconds": {"type": "number", "minimum": 0},
        "estimated_cost_usd": {"type": "number", "minimum": 0},
        "stage_metrics": {"type": "array", "items": {"$ref": "#/$defs/stageMetric"}},
        "total_duration_ms": {"type": "number", "minimum": 0},
        "stage_metric_scope": {"type": "string"},
        "s13_status": {"const": "NOT_EXECUTED_IN_WEB_PREVIEW"}
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "text", "evidence_frame_ids", "support_grade"],
      "properties": {
        "fact_id": {"type": "string", "format": "uuid"},
        "text": {"type": "string"},
        "evidence_frame_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "support_grade": {"enum": ["STRONG", "MODERATE", "WEAK"]}
      }
    },
    "degradation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json_field_path", "validation_rule_id", "action", "original_value_sentinel"],
      "properties": {
        "json_field_path": {"type": "string"},
        "validation_rule_id": {"type": "string"},
        "action": {"type": "string"},
        "original_value_sentinel": {"type": "string"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "asset_id", "source_asset_id", "media_kind", "status", "facts",
        "setting_code", "activity_code", "episode_code", "subject_codes", "motifs",
        "event_kind", "event_salience", "quality_score", "limitations",
        "degraded_fields", "evidence_frame_ids"
      ],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "asset_id": {"type": "string"},
        "source_asset_id": {"type": "string"},
        "media_kind": {"enum": ["PHOTO", "VIDEO"]},
        "status": {"enum": ["OBSERVED", "PARTIAL", "INSUFFICIENT_EVIDENCE", "FAILED"]},
        "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "setting_code": {"type": "string"},
        "activity_code": {"type": "string"},
        "episode_code": {"type": "string"},
        "subject_codes": {"type": "array", "items": {"type": "string"}},
        "motifs": {"type": "array", "items": {"type": "string"}},
        "event_kind": {"type": "string"},
        "event_salience": {"type": "string"},
        "quality_score": {"type": "number", "minimum": 0, "maximum": 1},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "degraded_fields": {"type": "array", "items": {"$ref": "#/$defs/degradation"}},
        "evidence_frame_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "moment": {
      "type": "object",
      "required": ["id", "sequence_index", "observation_ids", "asset_ids", "source_asset_ids", "episode_codes", "setting_codes", "activity_codes", "roles", "time_label"]
    },
    "media": {
      "type": "object",
      "required": ["asset_id", "source_asset_id", "observation_id", "role", "media_kind", "preview_format", "evidence_frame_ids", "quality_score", "motifs"]
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "candidate_id", "title", "time_label", "story", "tags", "moment_ids", "hero_asset_id", "selected_media", "evidence_support", "evidence_frame_ids", "claims", "publication_status"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "candidate_id": {"type": "string", "format": "uuid"},
        "title": {"type": "string"},
        "time_label": {"type": "string"},
        "story": {"type": "string"},
        "tags": {"type": "array", "maxItems": 4, "items": {"type": "string"}},
        "moment_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "hero_asset_id": {"type": "string"},
        "selected_media": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/media"}},
        "evidence_support": {"enum": ["STRONG", "MODERATE", "LIMITED"]},
        "evidence_frame_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fact"}},
        "publication_status": {"const": "STAGED_PREVIEW_VALIDATED"}
      }
    },
    "stageMetric": {
      "type": "object",
      "required": ["stage", "duration_ms", "model_calls", "input_tokens", "output_tokens", "estimated_cost_usd"],
      "properties": {
        "stage": {"type": "string"},
        "duration_ms": {"type": "number", "minimum": 0},
        "model_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "estimated_cost_usd": {"type": "number", "minimum": 0}
      }
    }
  }
}
