{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diary.one/contracts/app_library_bundle_v02.schema.json",
  "title": "Diary One Phone-library Test Bundle V02",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_version", "research_only", "session", "device", "normalization", "assets"],
  "properties": {
    "bundle_version": {"const": "DIARY_ONE_APP_LIBRARY_BUNDLE_V02"},
    "research_only": {"const": true},
    "session": {
      "type": "object",
      "required": ["session_id", "exported_at", "timezone"]
    },
    "device": {
      "type": "object",
      "required": ["device_id", "hardware_revision", "firmware_version", "sdk_version"]
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "orientation", "aspect_ratio", "spatial_transform", "temporal_transform", "canonical_frame_offsets_ms", "evidence_profile_version"],
      "properties": {
        "width": {"const": 768},
        "height": {"const": 1024},
        "orientation": {"const": "PORTRAIT"},
        "aspect_ratio": {"const": "3:4"},
        "spatial_transform": {"const": "CENTER_CROP_ASPECT_FILL"},
        "temporal_transform": {"const": "PHONE_TEST_DURATION_WINDOWS_V01"},
        "canonical_frame_offsets_ms": {"const": [1500, 4500, 7500]},
        "evidence_profile_version": {"const": "PHONE_TEST_DURATION_WINDOWS_V01"}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "media_kind", "media_source", "original_file_extension", "original_sha256", "original_bytes", "original_width", "original_height", "original_duration_ms", "original_included", "timeline_offset_ms", "logical_asset_duration_ms", "materialized_video", "evidence_sampling_profile", "evidence_window_count", "frames"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "source_display_name": {"type": "string"},
          "media_kind": {"enum": ["PHOTO", "VIDEO"]},
          "media_source": {"const": "PHONE_LIBRARY_DAY_TEST"},
          "original_file_extension": {"type": "string"},
          "original_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "original_bytes": {"type": "integer", "minimum": 0},
          "original_width": {"type": "integer", "minimum": 1},
          "original_height": {"type": "integer", "minimum": 1},
          "original_duration_ms": {"type": ["integer", "null"], "minimum": 1},
          "original_included": {"const": false},
          "timeline_offset_ms": {"type": "integer", "minimum": 0},
          "logical_asset_duration_ms": {"const": 9000},
          "materialized_video": {"const": false},
          "evidence_sampling_profile": {"enum": ["PHOTO_SINGLE_FRAME", "VIDEO_SINGLE_WINDOW_THREE", "VIDEO_MULTI_WINDOW_TWO_PER_WINDOW"]},
          "evidence_window_count": {"enum": [1, 2, 4, 6]},
          "frames": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["frame_id", "window_index", "window_count", "sample_role", "canonical_offset_ms", "source_timestamp_ms", "relative_path", "sha256", "width", "height", "spatial_transform"],
              "properties": {
                "frame_id": {"type": "string", "minLength": 1},
                "window_index": {"type": "integer", "minimum": 0, "maximum": 5},
                "window_count": {"enum": [1, 2, 4, 6]},
                "sample_role": {"enum": ["PHOTO_REPRESENTATIVE", "WINDOW_EARLY", "WINDOW_MIDDLE", "WINDOW_LATE"]},
                "canonical_offset_ms": {"enum": [1500, 4500, 7500]},
                "source_timestamp_ms": {"type": ["integer", "null"], "minimum": 0},
                "relative_path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "width": {"const": 768},
                "height": {"const": 1024},
                "spatial_transform": {"const": "CENTER_CROP_ASPECT_FILL"}
              }
            }
          }
        }
      }
    }
  }
}
